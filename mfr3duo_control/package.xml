<?xml version="1.0"?>
<package format="3">
  <name>mfr3duo_control</name><version>0.1.0</version>
  <description>MFR3Duo command execution and ros2_control integration.</description>
  <maintainer email="maintainers@example.com">mfr3duo maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>controller_interface</depend><depend>hardware_interface</depend>
  <depend>geometry_msgs</depend><depend>pluginlib</depend>
  <depend>rclcpp</depend><depend>rclcpp_lifecycle</depend><depend>realtime_tools</depend>
  <depend>controller_manager_msgs</depend><depend>trajectory_msgs</depend>
  <depend>sensor_msgs</depend><depend>std_msgs</depend><depend>urdf</depend>
  <depend>rclcpp_action</depend><depend>control_msgs</depend><depend>mfr3duo_msgs</depend>
  <depend>nav_msgs</depend><depend>tf2_msgs</depend><depend>diagnostic_msgs</depend>
  <exec_depend>mfr3duo_hardware</exec_depend><exec_depend>xacro</exec_depend>
  <exec_depend>controller_manager</exec_depend><exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend><exec_depend>imu_sensor_broadcaster</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend><exec_depend>launch_ros</exec_depend>
  <test_depend>rclpy</test_depend>

  <test_depend>action_msgs</test_depend>
  <test_depend>ament_index_python</test_depend><test_depend>python3-yaml</test_depend>
  <test_depend>ros2launch</test_depend><test_depend>tf2_msgs</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
