<?xml version="1.0" encoding="UTF-8"?>
<!-- The MJCF path is substituted by mfr3duo_mujoco::Simulation at runtime. -->
<robot_mujoco>
  <mujoco><mjcf>@MJCF_PATH@</mjcf></mujoco>
  <simulation>
    <physics period="0.001"/>
    <viewer period="0.016666666666666666" enabled="@VIEWER_ENABLED@"/>
  </simulation>
  <robot>
    <!-- FR3 arms: IDs 0-13. -->
    <joint id="0" name="left_fr3v2_1_joint1" actuator="left_fr3v2_1_joint1_motor" mode="position" period="0.001"><control><hybrid stiffness="600" damping="30"/><position stiffness="600" damping="30"/><velocity damping="30"/><effort/></control><limit><position min="-2.900740017" max="2.900740017"/><velocity min="-2.62" max="2.62"/><effort min="-87" max="87"/></limit></joint>
    <joint id="1" name="left_fr3v2_1_joint2" actuator="left_fr3v2_1_joint2_motor" mode="position" period="0.001"><control><hybrid stiffness="600" damping="30"/><position stiffness="600" damping="30"/><velocity damping="30"/><effort/></control><limit><position min="-1.836090017" max="1.836090017"/><velocity min="-2.62" max="2.62"/><effort min="-87" max="87"/></limit></joint>
    <joint id="2" name="left_fr3v2_1_joint3" actuator="left_fr3v2_1_joint3_motor" mode="position" period="0.001"><control><hybrid stiffness="600" damping="30"/><position stiffness="600" damping="30"/><velocity damping="30"/><effort/></control><limit><position min="-2.900740017" max="2.900740017"/><velocity min="-2.62" max="2.62"/><effort min="-87" max="87"/></limit></joint>
    <joint id="3" name="left_fr3v2_1_joint4" actuator="left_fr3v2_1_joint4_motor" mode="position" period="0.001"><control><hybrid stiffness="600" damping="30"/><position stiffness="600" damping="30"/><velocity damping="30"/><effort/></control><limit><position min="-3.077020017" max="-0.1169370833"/><velocity min="-2.62" max="2.62"/><effort min="-87" max="87"/></limit></joint>
    <joint id="4" name="left_fr3v2_1_joint5" actuator="left_fr3v2_1_joint5_motor" mode="position" period="0.001"><control><hybrid stiffness="250" damping="10"/><position stiffness="250" damping="10"/><velocity damping="10"/><effort/></control><limit><position min="-2.87630335" max="2.87630335"/><velocity min="-5.26" max="5.26"/><effort min="-12" max="12"/></limit></joint>
    <joint id="5" name="left_fr3v2_1_joint6" actuator="left_fr3v2_1_joint6_motor" mode="position" period="0.001"><control><hybrid stiffness="150" damping="10"/><position stiffness="150" damping="10"/><velocity damping="10"/><effort/></control><limit><position min="0.43982265" max="4.62163335"/><velocity min="-4.18" max="4.18"/><effort min="-12" max="12"/></limit></joint>
    <joint id="6" name="left_fr3v2_1_joint7" actuator="left_fr3v2_1_joint7_motor" mode="position" period="0.001"><control><hybrid stiffness="50" damping="5"/><position stiffness="50" damping="5"/><velocity damping="5"/><effort/></control><limit><position min="-3.05083335" max="3.05083335"/><velocity min="-5.26" max="5.26"/><effort min="-12" max="12"/></limit></joint>
    <joint id="7" name="right_fr3v2_1_joint1" actuator="right_fr3v2_1_joint1_motor" mode="position" period="0.001"><control><hybrid stiffness="600" damping="30"/><position stiffness="600" damping="30"/><velocity damping="30"/><effort/></control><limit><position min="-2.900740017" max="2.900740017"/><velocity min="-2.62" max="2.62"/><effort min="-87" max="87"/></limit></joint>
    <joint id="8" name="right_fr3v2_1_joint2" actuator="right_fr3v2_1_joint2_motor" mode="position" period="0.001"><control><hybrid stiffness="600" damping="30"/><position stiffness="600" damping="30"/><velocity damping="30"/><effort/></control><limit><position min="-1.836090017" max="1.836090017"/><velocity min="-2.62" max="2.62"/><effort min="-87" max="87"/></limit></joint>
    <joint id="9" name="right_fr3v2_1_joint3" actuator="right_fr3v2_1_joint3_motor" mode="position" period="0.001"><control><hybrid stiffness="600" damping="30"/><position stiffness="600" damping="30"/><velocity damping="30"/><effort/></control><limit><position min="-2.900740017" max="2.900740017"/><velocity min="-2.62" max="2.62"/><effort min="-87" max="87"/></limit></joint>
    <joint id="10" name="right_fr3v2_1_joint4" actuator="right_fr3v2_1_joint4_motor" mode="position" period="0.001"><control><hybrid stiffness="600" damping="30"/><position stiffness="600" damping="30"/><velocity damping="30"/><effort/></control><limit><position min="-3.077020017" max="-0.1169370833"/><velocity min="-2.62" max="2.62"/><effort min="-87" max="87"/></limit></joint>
    <joint id="11" name="right_fr3v2_1_joint5" actuator="right_fr3v2_1_joint5_motor" mode="position" period="0.001"><control><hybrid stiffness="250" damping="10"/><position stiffness="250" damping="10"/><velocity damping="10"/><effort/></control><limit><position min="-2.87630335" max="2.87630335"/><velocity min="-5.26" max="5.26"/><effort min="-12" max="12"/></limit></joint>
    <joint id="12" name="right_fr3v2_1_joint6" actuator="right_fr3v2_1_joint6_motor" mode="position" period="0.001"><control><hybrid stiffness="150" damping="10"/><position stiffness="150" damping="10"/><velocity damping="10"/><effort/></control><limit><position min="0.43982265" max="4.62163335"/><velocity min="-4.18" max="4.18"/><effort min="-12" max="12"/></limit></joint>
    <joint id="13" name="right_fr3v2_1_joint7" actuator="right_fr3v2_1_joint7_motor" mode="position" period="0.001"><control><hybrid stiffness="50" damping="5"/><position stiffness="50" damping="5"/><velocity damping="5"/><effort/></control><limit><position min="-3.05083335" max="3.05083335"/><velocity min="-5.26" max="5.26"/><effort min="-12" max="12"/></limit></joint>
    <joint id="14" name="franka_spine_vertical_joint" actuator="franka_spine_motor" mode="position" period="0.001"><control><hybrid stiffness="1500" damping="150"/><position stiffness="1500" damping="150"/><velocity damping="250"/><effort/></control><limit><position min="0" max="0.85"/><velocity min="-0.1" max="0.1"/><effort min="-600" max="600"/></limit></joint>
    <!-- TMR steering and drive joints: IDs 15-18. -->
    <joint id="15" name="tmrv0_2_joint_0" actuator="tmrv0_2_joint_0_motor" mode="position" period="0.001"><control><position stiffness="100" damping="20"/></control><limit><position min="-6.283185307" max="6.283185307"/><effort min="-500" max="500"/></limit></joint>
    <joint id="16" name="tmrv0_2_joint_1" actuator="tmrv0_2_joint_1_motor" mode="velocity" period="0.001"><control><velocity damping="25"/></control><limit><effort min="-500" max="500"/></limit></joint>
    <joint id="17" name="tmrv0_2_joint_2" actuator="tmrv0_2_joint_2_motor" mode="position" period="0.001"><control><position stiffness="100" damping="20"/></control><limit><position min="-6.283185307" max="6.283185307"/><effort min="-500" max="500"/></limit></joint>
    <joint id="18" name="tmrv0_2_joint_3" actuator="tmrv0_2_joint_3_motor" mode="velocity" period="0.001"><control><velocity damping="25"/></control><limit><effort min="-500" max="500"/></limit></joint>
    <!-- Passive joints deliberately have no actuator, mode, control, or limits. -->
    <joint id="19" name="rocker_arm_joint" actuation="passive" period="0.001"/>
    <joint id="20" name="caster_front_left_steering_joint" actuation="passive" period="0.001"/>
    <joint id="21" name="caster_front_left_joint" actuation="passive" period="0.001"/>
    <joint id="22" name="caster_rear_right_steering_joint" actuation="passive" period="0.001"/>
    <joint id="23" name="caster_rear_right_joint" actuation="passive" period="0.001"/>
    <joint id="24" name="left_fr3v2_1_finger_joint1" actuator="left_fr3v2_1_finger_motor" mode="position" period="0.001"><control><hybrid stiffness="1000" damping="20"/><position stiffness="1000" damping="20"/><velocity damping="100"/><effort/></control><limit><position min="0" max="0.04"/><velocity min="-0.2" max="0.2"/><effort min="-100" max="100"/></limit></joint>
    <joint id="25" name="left_fr3v2_1_finger_joint2" actuation="passive" period="0.001"/>
    <joint id="26" name="right_fr3v2_1_finger_joint1" actuator="right_fr3v2_1_finger_motor" mode="position" period="0.001"><control><hybrid stiffness="1000" damping="20"/><position stiffness="1000" damping="20"/><velocity damping="100"/><effort/></control><limit><position min="0" max="0.04"/><velocity min="-0.2" max="0.2"/><effort min="-100" max="100"/></limit></joint>
    <joint id="27" name="right_fr3v2_1_finger_joint2" actuation="passive" period="0.001"/>
    <imu id="0" name="imu" frame_id="imu_link" framequat_sensor="imu_orientation" gyro_sensor="imu_angular_velocity" accelerometer_sensor="imu_linear_acceleration" period="0.001"/>
    <camera id="0" name="BaseFrontColor" camera_name="camera_front_color" frame_id="camera_front_color_frame" optical_frame_id="camera_front_color_optical_frame" width="1280" height="720" enable_rgb="true" enable_depth="false" period="0.033333333333333333"/>
    <camera id="1" name="BaseFrontDepth" camera_name="camera_front_depth" frame_id="camera_front_depth_frame" optical_frame_id="camera_front_depth_optical_frame" width="1280" height="720" enable_rgb="false" enable_depth="true" period="0.033333333333333333"/>
    <camera id="2" name="BaseRearColor" camera_name="camera_rear_color" frame_id="camera_rear_color_frame" optical_frame_id="camera_rear_color_optical_frame" width="1280" height="720" enable_rgb="true" enable_depth="false" period="0.033333333333333333"/>
    <camera id="3" name="BaseRearDepth" camera_name="camera_rear_depth" frame_id="camera_rear_depth_frame" optical_frame_id="camera_rear_depth_optical_frame" width="1280" height="720" enable_rgb="false" enable_depth="true" period="0.033333333333333333"/>
    <camera id="4" name="BaseLeftColor" camera_name="camera_left_color" frame_id="camera_left_color_frame" optical_frame_id="camera_left_color_optical_frame" width="1280" height="720" enable_rgb="true" enable_depth="false" period="0.033333333333333333"/>
    <camera id="5" name="BaseLeftDepth" camera_name="camera_left_depth" frame_id="camera_left_depth_frame" optical_frame_id="camera_left_depth_optical_frame" width="1280" height="720" enable_rgb="false" enable_depth="true" period="0.033333333333333333"/>
    <camera id="6" name="BaseRightColor" camera_name="camera_right_color" frame_id="camera_right_color_frame" optical_frame_id="camera_right_color_optical_frame" width="1280" height="720" enable_rgb="true" enable_depth="false" period="0.033333333333333333"/>
    <camera id="7" name="BaseRightDepth" camera_name="camera_right_depth" frame_id="camera_right_depth_frame" optical_frame_id="camera_right_depth_optical_frame" width="1280" height="720" enable_rgb="false" enable_depth="true" period="0.033333333333333333"/>
    <camera id="8" name="LeftWristColor" camera_name="d435_left_rgb" frame_id="left_d435_link" optical_frame_id="left_d435_color_optical_frame" width="1280" height="720" enable_rgb="true" enable_depth="false" period="0.033333333333333333"/>
    <camera id="9" name="LeftWristDepth" camera_name="d435_left_depth" frame_id="left_d435_link" optical_frame_id="left_d435_depth_optical_frame" width="1280" height="720" enable_rgb="false" enable_depth="true" period="0.033333333333333333"/>
    <camera id="10" name="RightWristColor" camera_name="d435_right_rgb" frame_id="right_d435_link" optical_frame_id="right_d435_color_optical_frame" width="1280" height="720" enable_rgb="true" enable_depth="false" period="0.033333333333333333"/>
    <camera id="11" name="RightWristDepth" camera_name="d435_right_depth" frame_id="right_d435_link" optical_frame_id="right_d435_depth_optical_frame" width="1280" height="720" enable_rgb="false" enable_depth="true" period="0.033333333333333333"/>
    <camera id="12" name="HeadLeft" camera_name="head_zed_left" frame_id="head_zed_left_camera_frame" optical_frame_id="head_zed_left_camera_optical_frame" width="1280" height="720" enable_rgb="true" enable_depth="false" period="0.033333333333333333"/>
    <camera id="13" name="HeadRight" camera_name="head_zed_right" frame_id="head_zed_right_camera_frame" optical_frame_id="head_zed_right_camera_optical_frame" width="1280" height="720" enable_rgb="true" enable_depth="false" period="0.033333333333333333"/>
  </robot>
</robot_mujoco>
